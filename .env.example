# Copy to .env and fill in. Never commit .env.

# Public HTTPS address of this server (your domain, Railway/Render URL, or ngrok URL while testing)
PUBLIC_BASE_URL=https://voice.yourdomain.com

# Twilio — console.twilio.com > Account info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VALIDATE_TWILIO_SIGNATURE=true

# Anthropic (Claude) — console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
SUMMARY_MODEL=claude-haiku-4-5

# Deepgram (speech-to-text) — console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general

# Cartesia (text-to-speech) — play.cartesia.ai
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49

# One Cal.com API key per client (name must match api_key_env in the client's YAML)
CALCOM_API_KEY_SUNRISE=

# Security — use long random strings (e.g. run: python -c "import secrets;print(secrets.token_urlsafe(32))")
APP_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Operations
DATABASE_PATH=data/leads.db
CLIENTS_DIR=clients
MAX_CONCURRENT_CALLS=20
MAX_CALL_MINUTES=12
USER_IDLE_SECONDS=8
LOG_LEVEL=INFO
